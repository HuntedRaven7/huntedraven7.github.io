---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';

const bar = (n: number) => '█'.repeat(n) + '░'.repeat(Math.max(0, 5 - n));

const skills = [
	['Podman', 5],
	['Bluefin', 5],
	['k0s', 4],
	['Bootc', 4],
	['Containerfiles', 3],
] as [string, number][];

const ticker = [
	'Containers',
	'Blogs',
	'Opensource',
	'Random tools',
	'Extensions',
	'GUI Tooling',
];
---

<Layout>
	<div class="site">
		<Header />

		<main>
			<!-- ============ HERO ============ -->
			<section id="home" class="hero wrap">
				<div class="hero-copy">
					<p class="label hero-kicker">personal homepage // est. 2026</p>
					<h1 class="display sunray hero-title">robin</h1>
					<p class="hero-sub">
						A Dev building her way through one container at a time — Podman > Docker,
						sane design and ofc something that just works.
					</p>
					<div class="hero-ctas">
						<a class="btn btn-solid" href="#work">see the work</a>
						<a
						class="btn btn-ghost"
						href="https://robin.tarxz.zip/blog"
						target="_blank"
						rel="noopener noreferrer"
					>read the blog</a
					>
					</div>
				</div>

				<div class="window hero-term" aria-hidden="true">
					<div class="window-bar">
						<span class="wdot" style="background:#f43753"></span>
						<span class="wdot" style="background:#ffc24b"></span>
						<span class="wdot" style="background:#c9d05c"></span>
						<span class="window-title">robin@nest: ~</span>
					</div>
					<div class="window-body">
						<p><span class="t-prompt">$</span> whoami</p>
						<p class="t-out">Robin</p>
						<p><span class="t-prompt">$</span> ls ~/projects</p>
						<p class="t-out">Bluefin LTS maintainer</p>
						<p class="t-out">Microraptor (FSDK Sever Image)</p>
						<p class="t-out">and more!</p>
						<p><span class="t-prompt">$</span> cat ~/status.txt</p>
						<p class="t-out">OS: Bluefin (CentOS10 Stream Bootc version)</p>
						<p class="t-out">Fav-langs: Elixir, Zig and Rust</p>
						<p class="t-out">
							Misc: <a class="t-link" href="https://robin.tarxz.zip/blog">https://robin.tarxz.zip/blog</a
							><span class="t-cursor" aria-hidden="true">█</span>
						</p>
					</div>
				</div>
			</section>

			<!-- ============ TICKER ============ -->
			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					{[0, 1].map((dup) =>
						ticker.map((t) => (
							<span class="marquee-item" key={`${dup}-${t}`}>
								<span class="marquee-dot">◇</span> {t}
							</span>
						))
					)}
				</div>
			</div>

			<!-- ============ WORK POPOUT ============ -->
			<dialog class="popout" id="dlg-work">
				<button class="popout-close" type="button" data-close aria-label="Close popup">×</button>
				<section class="wrap section">
					<header class="section-head">
						<p class="label">// 01 · work</p>
						<h2 class="display section-title">Selected work, partially in orbit.</h2>
					</header>

					<div class="rows">
					{
						[
							['this site', 'personal homepage, rebuilt until it felt right', 'astro · 2026', 'shipped'],
							['Microraptor', 'an FSDK-based, image-based Linux server OS with Network Manager.', 'buildstream · fsdk', 'ground-station', 'https://github.com/HuntedRaven7/Microraptor'],
							['Bluefin LTS', 'an image-based Linux desktop on CentOS with bootc — I\'m a maintainer.', 'bootc · fedora', 'in orbit', 'https://github.com/projectbluefin/bluefin-lts'],
							['blueprint', 'my own custom Ublue-OS style Bootc images based on anything!', 'bootc · ublue', 'drifting', 'https://github.com/HuntedRaven7/blueprint'],
						].map(([title, desc, tags, status, href], i) => (
							href ? (
								<a class="row row-link link" href={href} target="_blank" rel="noopener noreferrer">
									<div class="row-meta">
										<span class="label row-idx">{String(i + 1).padStart(2, '0')}</span>
										<span class="label row-status">{status}</span>
									</div>
									<h3 class="display row-title">{title}</h3>
									<p class="row-desc">{desc}</p>
									<span class="label row-tags">{tags}</span>
									<span class="row-arrow" aria-hidden="true">→</span>
								</a>
							) : (
								<article class="row">
									<div class="row-meta">
										<span class="label row-idx">{String(i + 1).padStart(2, '0')}</span>
										<span class="label row-status">{status}</span>
									</div>
									<h3 class="display row-title">{title}</h3>
									<p class="row-desc">{desc}</p>
									<span class="label row-tags">{tags}</span>
									<span class="row-arrow" aria-hidden="true">→</span>
								</article>
							)
						))
					}
				</div>
				</section>
			</dialog>

			<!-- ============ ABOUT POPOUT ============ -->
			<dialog class="popout" id="dlg-about">
				<button class="popout-close" type="button" data-close aria-label="Close popup">×</button>
				<section class="wrap section">
					<header class="section-head">
						<p class="label">// 02 · about</p>
						<h2 class="display section-title">About Robin</h2>
					</header>

				<div class="about-grid">
					<div class="about-bio">
						<p>
							Hi, I am a dev that loves helping with open source! Whether it's something
							container native or a tool that helps others I will either build it or help, I just
							want to see open source flourish especially cloud native tech!
						</p>
						<p>
							Whatever it may be you can count on me to build it!
						</p>
						<div class="facts">
							<div class="fact"><span class="label">uptime</span><span class="mono">since 2007</span></div>
							<div class="fact"><span class="label">shell</span><span class="mono">bash+starship</span></div>
							<div class="fact"><span class="label">locale</span><span class="mono">Canada, Maple Mountains</span></div>
						</div>
					</div>
					<div class="about-skills">
						<p class="label">// container tooling</p>
						<ul class="skill-list">
							{skills.map(([name, lvl]) => (
								<li>
									<span class="skill-name">{name}</span>
									<span class="skill-bar" aria-label={`${name}: ${lvl} of 5`}>{bar(lvl)}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
				</section>
			</dialog>

			<!-- ============ JOURNAL POPOUT ============ -->
			<dialog class="popout" id="dlg-rss">
				<button class="popout-close" type="button" data-close aria-label="Close popup">×</button>
				<section class="wrap section">
					<header class="section-head">
						<p class="label">// 03 · rss feed</p>
						<h2 class="display section-title">RSS straight from my blog!</h2>
					</header>

				<div class="rows">
					{
						[
							['2026.08.02', 'notes from the dark of the terminal'],
							['2026.06.14', 'the case for ugly web designs'],
							['2026.04.03', 'the site redesign, part iv: restraint'],
							['2026.01.27', 'minimal is a spectrum'],
						].map(([date, title]) => (
							<a class="row row-link link" href="#rss">
								<span class="label row-date">{date}</span>
								<span class="display row-title">{title}</span>
								<span class="row-arrow" aria-hidden="true">→</span>
							</a>
						))
					}
				</div>
				</section>
			</dialog>

			<!-- ============ LAB POPOUT ============ -->
			<dialog class="popout" id="dlg-lab">
				<button class="popout-close" type="button" data-close aria-label="Close popup">×</button>
				<section class="wrap section">
					<header class="section-head">
						<p class="label">// 04 · lab</p>
						<h2 class="display section-title">The lab, welcome to my Homelab.</h2>
					</header>

				<div class="lab-grid">
					{
						[
							[
								'Vaultwarden',
								'self-hosted password manager — a lightweight Bitwarden-compatible server.',
								'running',
							],
							[
								'k0s',
								'lightweight Kubernetes distribution I use to run the cluster underneath the lab.',
								'tool',
							],
							[
								'Pi-hole',
								'network-wide ad blocker and local DNS, quietly filtering at the edge.',
								'running',
							],
							[
								'Homepage',
								'a clean dashboard that fronts every service in one place.',
								'running',
							],
						].map(([title, desc, state]) => (
							<div class="lab-card">
								<span class="label lab-state">{state}</span>
								<h3 class="display lab-title">{title}</h3>
								<p class="lab-desc">{desc}</p>
							</div>
						))
					}
				</div>
				</section>
			</dialog>

			<!-- ============ CONTACT POPOUT ============ -->
			<dialog class="popout" id="dlg-contact">
				<button class="popout-close" type="button" data-close aria-label="Close popup">×</button>
				<section class="wrap section">
					<header class="section-head">
						<p class="label">// 05 · contact</p>
						<h2 class="display section-title">Open channels.</h2>
					</header>

				<div class="rows">
					{
						[
							['github', 'https://github.com/huntedraven7', '@huntedraven7', true],
						].map(([k, href, text, external]) => (
							<a
								class="row row-link link"
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								<span class="label row-date">{k}</span>
								<span class="display row-title">{text}</span>
								<span class="row-arrow" aria-hidden="true">→</span>
							</a>
						))
					}
				</div>
				</section>
			</dialog>

			<!-- ============ COMMENTS ============ -->
			<section id="comments" class="wrap section">
				<header class="section-head">
					<p class="label">// 06 · comments</p>
					<h2 class="display section-title">The guestbook.</h2>
				</header>
				<script is:inline>
					(function () {
						var theme = 'github-dark';
						try {
							if (localStorage.getItem('hr7-theme') === 'light') theme = 'github-light';
						} catch (e) {}
						var s = document.createElement('script');
						s.src = 'https://utteranc.es/client.js';
						s.async = true;
						s.crossOrigin = 'anonymous';
						s.setAttribute('repo', 'HuntedRaven7/huntedraven7.github.io');
						s.setAttribute('issue-term', 'pathname');
						s.setAttribute('theme', theme);
						document.getElementById('comments').appendChild(s);
					})();
				</script>
			</section>

			<footer class="footer wrap">
				<span class="label">robin</span>
				<span class="label">built with astro · solar powered</span>
				<span class="label">press <kbd>T</kbd> for theme</span>
			</footer>
		</main>
	</div>
</Layout>

<style>
	.site {
		max-width: 92rem;
		margin-inline: auto;
	}

	main {
		padding: 0 clamp(1.25rem, 4vw, 3.25rem) 4rem clamp(17.5rem, 20vw, 19.5rem);
		min-width: 0;
		--popout-left: clamp(17.5rem, 20vw, 19.5rem);
		--popout-right: clamp(1.25rem, 4vw, 3.25rem);
	}

	.wrap {
		max-width: 46rem;
	}

	.wrap.section {
		margin-inline: 0;
		max-width: 60rem;
	}

	.mono {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	/* ============ HERO ============ */
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
		max-width: 74rem;
		padding: clamp(3.5rem, 9vh, 6.5rem) 0;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: -12% 0;
		background-image: url('/assets/hero.jpg?v=2');
		background-size: cover;
		background-position: center;
		mask-image: radial-gradient(
			ellipse 48% 50% at 50% 50%,
			#000 48%,
			rgba(0, 0, 0, 0.65) 72%,
			transparent 100%
		);
		-webkit-mask-image: radial-gradient(
			ellipse 48% 50% at 50% 50%,
			#000 48%,
			rgba(0, 0, 0, 0.65) 72%,
			transparent 100%
		);
		z-index: 0;
		pointer-events: none;
		opacity: 0.5;
		filter: saturate(1.15) contrast(1.05);
	}

	.hero-copy,
	.hero-term {
		position: relative;
		z-index: 1;
	}

	.hero-copy {
		padding-right: 2rem;
	}

	.hero-kicker {
		color: var(--ink-soft);
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
	}

	.hero-title {
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.55))
			drop-shadow(0 14px 34px rgba(0, 0, 0, 0.4));
	}

	.hero-sub {
		color: var(--ink);
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.65), 0 6px 24px rgba(0, 0, 0, 0.55);
	}

	.hero-kicker {
		margin-bottom: 1.6rem;
	}

	.hero-title {
		font-size: clamp(4rem, 11vw, 8.5rem);
		line-height: 0.98;
		margin: 0;
	}

	.hero-sub {
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 34ch;
		margin: 1.4rem 0 2rem;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.btn {
		font-family: var(--mono);
		font-size: 0.76rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.7rem 1.25rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.btn-solid {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--paper);
	}

	.btn-solid:hover {
		background: var(--accent-2);
		border-color: var(--accent-2);
	}

	.btn-ghost {
		color: var(--ink);
	}

	.btn-ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* ---- terminal window ---- */
	.window {
		border: 1px solid var(--line);
		border-radius: 12px;
		background: color-mix(in srgb, color-mix(in srgb, var(--paper) 88%, #000) 60%, var(--paper));
		box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.45);
		overflow: hidden;
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 0.95rem;
		border-bottom: 1px solid var(--line);
	}

	.wdot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		opacity: 0.9;
	}

	.window-title {
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
		letter-spacing: 0.06em;
		margin-left: 0.6rem;
	}

	.window-body {
		font-family: var(--mono);
		font-size: clamp(0.72rem, 1.3vw, 0.85rem);
		line-height: 1.7;
		padding: 1rem 1.15rem 1.2rem;
		color: var(--ink-soft);
	}

	.window-body p {
		margin: 0;
	}

	.t-prompt {
		color: var(--accent);
		margin-right: 0.4rem;
	}

	.t-out {
		color: var(--muted);
		padding-left: 1.15rem;
	}

	.t-link {
		color: var(--accent-2);
		text-decoration: none;
	}

	.t-link:hover {
		text-decoration: underline;
	}

	.t-cursor {
		display: inline-block;
		color: var(--accent);
		animation: cursor-blink 1.1s steps(2, start) infinite;
		margin-left: 0.25rem;
	}

	@keyframes cursor-blink {
		50% { opacity: 0; }
	}

	/* ============ TICKER ============ */
	.marquee {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 0.8rem 0;
	}

	.marquee-item {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.marquee-dot {
		color: var(--accent);
		margin-right: 0.45rem;
	}

	/* ============ SECTIONS ============ */
	.section {
		padding-top: clamp(3.5rem, 7vh, 5.5rem);
	}

	.section + .section {
		margin-top: clamp(2.5rem, 5vh, 4rem);
	}

	.section-head {
		margin-bottom: 2.2rem;
	}

	.section-title {
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.05;
		margin: 0.7rem 0 0;
		max-width: 20ch;
		color: var(--heading-soft);
	}

	/* ============ ROWS (work / journal / contact) ============ */
	.rows {
		border-top: 1px solid var(--line);
	}

	.row {
		position: relative;
		display: grid;
		grid-template-columns: 5.5rem 1fr auto;
		gap: 0.15rem 1.5rem;
		padding: 1.4rem 0.25rem;
		border-bottom: 1px solid var(--line);
		color: var(--ink);
		transition: background 0.2s ease;
	}

	.row-meta {
		grid-row: 1 / span 3;
		align-self: start;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.row-title {
		font-size: clamp(1.15rem, 2.4vw, 1.6rem);
		margin: 0;
		transition: color 0.2s ease;
	}

	.row-desc {
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 44ch;
		margin: 0.4rem 0 0;
	}

	.row-tags {
		margin-top: 0.75rem;
		font-size: 0.62rem;
	}

	.row-status {
		font-size: 0.6rem;
	}

	.row-date {
		grid-row: 1 / span 1;
		padding-top: 0.35rem;
		font-size: 0.68rem;
	}

	.row-arrow {
		grid-column: 3;
		grid-row: 1 / span 3;
		align-self: center;
		font-family: var(--mono);
		font-size: 1.2rem;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-8px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.row:hover .row-title {
		color: var(--accent);
	}

	.row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	/* ============ ABOUT ============ */
	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.about-bio p {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-soft);
		margin: 0 0 1rem;
	}

	.facts {
		margin-top: 1.6rem;
		border-top: 1px solid var(--line);
	}

	.fact {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--line);
	}

	.fact .label {
		font-size: 0.6rem;
	}

	.skill-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.skill-list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.skill-name {
		font-family: var(--mono);
		font-size: 0.8rem;
	}

	.skill-bar {
		font-family: var(--mono);
		font-size: 0.9rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		white-space: nowrap;
	}

	/* ============ LAB ============ */
	.lab-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
	}

	.lab-card {
		background: var(--paper);
		padding: 1.3rem 1.3rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-height: 8.5rem;
		transition: background 0.2s ease;
	}

	.lab-card:hover {
		background: color-mix(in srgb, var(--accent) 8%, var(--paper));
	}

	.lab-state {
		font-size: 0.6rem;
		color: var(--muted);
	}

	.lab-title {
		font-size: 1.15rem;
		margin: auto 0 0;
	}

	.lab-desc {
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--ink-soft);
		margin: 0;
	}

	/* ============ FOOTER ============ */
	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: clamp(3rem, 6vh, 5rem);
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
	}

	.footer .label {
		font-size: 0.62rem;
	}

	kbd {
		font-family: var(--mono);
		border: 1px solid var(--line-strong);
		border-radius: 4px;
