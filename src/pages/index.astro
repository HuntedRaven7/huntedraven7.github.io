---
import Layout from '../layouts/Layout.astro'
import Card from '../components/Card.astro'
import DiscordStatus from '../components/DiscordStatus.astro'
---

<Layout>
	<main class="min-h-screen px-6 py-16 md:py-24 md:px-12 max-w-7xl mx-auto relative">
		<p class="absolute top-0 left-0 text-xs md:text-sm tracking-widest uppercase font-['Space_Grotesk']">
			<span class="text-white">Robin</span><span class="text-white/40">, Container nerd!</span>
		</p>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 md:mt-16">

			<div class="md:-rotate-1">
			<Card title="What I'm passionate about" color="yellow" rotation="-1">
				<p>Cloud-native design for the Linux desktop, optimized for performance and containerized workflows.</p>
				<p>I focus primarily on open source development — whatever you need built, I've got you covered.</p>
			</Card>
			</div>

			<div class="md:col-span-2 md:rotate-1 md:mt-10 md:max-w-[85%]">
			<Card title="Who I am" color="pink" rotation="1">
				<p>Eager to learn everything I can about Linux containers — Podman and beyond.</p>
				<p>Currently exploring BuildStream by Apache, the Free Desktop SDK, and always chasing the next side project.</p>
			</Card>
			</div>

			<div class="md:col-start-2 md:-ml-8 md:-rotate-2 md:max-w-sm relative">
				<Card title="Blog RSS" color="blue" rotation="-2" pfp="/pfp.png">
					<a href="https://robin.tarxz.zip/blog/" class="underline underline-offset-4 decoration-black/30 hover:decoration-black transition-colors">
						Subscribe to the RSS feed
					</a>
				</Card>
				<DiscordStatus />
			</div>

		</div>

		<div class="flex gap-3 mt-12">
			<a href="https://github.com/huntedraven7" target="_blank" rel="noopener noreferrer"
			   class="inline-flex items-center gap-2 px-5 py-3 text-xs uppercase tracking-widest border border-white/10 text-white/70 hover:text-white hover:border-white/30 transition-colors rounded-sm bg-white/[0.03]">
				GitHub
			</a>
			<button id="utterances-btn"
			        class="inline-flex items-center gap-2 px-5 py-3 text-xs uppercase tracking-widest border border-white/10 text-white/70 hover:text-white hover:border-white/30 transition-colors rounded-sm bg-white/[0.03]">
				Comments
			</button>
		</div>
	</main>

	<div id="utterances-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
		<div class="relative w-full max-w-3xl mx-4 max-h-[80vh] flex flex-col">
			<button id="utterances-close" class="absolute -top-10 right-0 text-white/60 hover:text-white text-sm uppercase tracking-wider z-10">Close</button>
			<div class="utterances-iframe-container border border-white/10 bg-white/[0.03] rounded-sm p-4 overflow-y-auto flex-1 min-h-[400px]"></div>
		</div>
	</div>

	<script>
		const modal = document.getElementById('utterances-modal')
		const btn = document.getElementById('utterances-btn')
		const close = document.getElementById('utterances-close')

		if (btn && modal && close) {
			btn.addEventListener('click', () => {
				modal.classList.remove('hidden')
				document.body.style.overflow = 'hidden'
				if (!document.getElementById('utterances-script')) {
					const s = document.createElement('script')
					s.src = 'https://utteranc.es/client.js'
					s.id = 'utterances-script'
					s.setAttribute('data-repo', 'huntedraven7/huntedraven7.github.io')
					s.setAttribute('data-issue-term', 'title')
					s.setAttribute('data-theme', 'dark')
					s.setAttribute('data-canonical', 'https://robin.tarxz.zip/')
					s.setAttribute('crossorigin', 'anonymous')
					s.async = true
					modal.querySelector('.utterances-iframe-container')?.appendChild(s)
				}
			})
			close.addEventListener('click', () => {
				modal.classList.add('hidden')
				document.body.style.overflow = ''
			})
			modal.addEventListener('click', (e) => {
				if (e.target === modal) {
					modal.classList.add('hidden')
					document.body.style.overflow = ''
				}
			})
		}
	</script>
</Layout>
