---
const links = [
	{ href: '#work', label: 'Work' },
	{ href: '#about', label: 'About' },
	{ href: '#rss', label: 'RSS Feed' },
	{ href: '#lab', label: 'Lab' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="side">
	<div class="side-brand">
		<a class="link brand-inner" href="#home">
			<span class="brand-mark" aria-hidden="true">*</span>
			<span class="brand-name display">Robin</span>
		</a>
		<p class="label side-tag">Container nerd</p>
	</div>

	<nav class="side-nav" aria-label="Primary">
		{links.map((l, i) => (
			<a class="link nav-link" href={l.href}>
				<span class="nav-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
				{l.label}
			</a>
		))}
	</nav>

	<div class="side-presence">
		<p class="label side-presence-hint">discord</p>
		<div id="lanyard"></div>
	</div>

	<div class="side-foot">
		<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme (press T)">
			<kbd aria-hidden="true">T</kbd>
			<span class="theme-name">theme</span>
		</button>
		<p class="label side-stamp">est. 2026</p>

		<script is:inline>
			(function () {
				var id = '523906270801952789';
				var box = document.getElementById('lanyard');
				box.innerHTML = '<p class="label side-presence-loading">connecting…</p>';

				var ws;
				var retry = 0;

				function render(d) {
					var act = null;
					if (d.activities) {
						for (var i = 0; i < d.activities.length; i++) {
							if (d.activities[i].type === 0) act = d.activities[i];
						}
						if (!act && d.activities.length) act = d.activities[0];
					}
					var status = d.discord_status || 'offline';
					var label;
					if (act && act.name) label = act.name;
					else if (status === 'online') label = 'online';
					else if (status === 'idle') label = 'idle';
					else if (status === 'dnd') label = 'do not disturb';
					else label = 'offline';

					var wrap = document.createElement('div');
					wrap.className = 'presence';

					var dot = document.createElement('span');
					dot.className = 'presence-dot ' + status;

					var name = document.createElement('span');
					name.className = 'presence-name mono';
					name.textContent = label;

					wrap.appendChild(dot);
					wrap.appendChild(name);
					box.textContent = '';
					box.appendChild(wrap);

					if (act && act.details) {
						var detail = document.createElement('p');
						detail.className = 'label side-presence-detail';
						detail.textContent = act.details;
						box.appendChild(detail);
					}
				}

				function connect() {
					try {
						ws = new WebSocket('wss://api.lanyard.rest/socket');
					} catch (e) {
						return;
					}
					ws.onopen = function () {
						ws.send(JSON.stringify({ op: 2, d: { subscribe_to_id: id } }));
					};
					ws.onmessage = function (ev) {
						var m;
						try {
							m = JSON.parse(ev.data);
						} catch (e) {
							return;
						}
						if (m.op === 1) {
							if (m.d && m.d.heartbeat_interval) {
								ws.send(
									JSON.stringify({ op: 1, d: { heartbeat_interval: m.d.heartbeat_interval } })
								);
							}
							return;
						}
						if (m.op === 0 && m.d && m.d[0] && m.d[0].d) {
							render(m.d[0].d);
						}
					};
					ws.onclose = function () {
						retry++;
						setTimeout(connect, Math.min(30000, 2000 * retry));
					};
				}

				connect();
			})();
		</script>
	</div>
</header>

<style>
	.side {
		position: fixed;
		z-index: 40;
		top: 50%;
		left: clamp(1rem, 2.5vw, 2.5rem);
		transform: translateY(-50%);
		width: 13.75rem;
		min-height: 52vh;
		max-height: calc(100svh - 3rem);
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
		padding: 2.4rem 1.15rem 2.6rem 1.55rem;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: color-mix(in srgb, var(--paper) 92%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.5);
	}

	.brand-inner {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.brand-mark {
		font-family: var(--mono);
		color: var(--accent);
		font-size: 1.05rem;
		line-height: 1;
	}

	.brand-name {
		font-size: 1.45rem;
		font-weight: 700;
	}

	.side-tag {
		margin: 0.6rem 0 0 1.6rem;
		font-size: 0.64rem;
		letter-spacing: 0.28em;
	}

	.side-nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.nav-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.8rem;
		font-family: var(--mono);
		font-size: 0.82rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		width: fit-content;
		padding: 0.4rem 0;
	}

	.nav-idx {
		font-size: 0.64rem;
		color: var(--muted);
	}

	.side-foot {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.1rem;
	}

	.side-presence {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-top: 0.2rem;
	}

	:global(.side-presence-hint) {
		font-size: 0.6rem;
		letter-spacing: 0.28em;
		color: var(--muted);
	}

	:global(.side-presence-loading) {
		font-size: 0.64rem;
		color: var(--muted);
	}

	:global(.presence) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	:global(.presence-dot) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	:global(.presence-dot.online) {
		background: #23a55a;
	}

	:global(.presence-dot.idle) {
		background: #f0b232;
	}

	:global(.presence-dot.dnd) {
		background: #f23f43;
	}

	:global(.presence-dot.offline) {
		background: var(--muted);
	}

	:global(.side-presence-detail) {
		font-size: 0.64rem;
		color: var(--muted);
		margin: 0;
		line-height: 1.4;
	}

	.side-stamp {
		font-size: 0.6rem;
		letter-spacing: 0.28em;
	}

	@media (max-width: 900px) {
		.side {
			position: sticky;
			top: 0;
			transform: none;
			left: auto;
			width: auto;
			max-height: none;
			height: auto;
			flex-direction: row;
			align-items: center;
			padding: 0.75rem 1.25rem;
			border: none;
			border-bottom: 1px solid var(--line);
			border-radius: 0;
			box-shadow: none;
		}

		.side-tag,
		.side-stamp {
			display: none;
		}

		.side-nav {
			flex-direction: row;
			margin-inline: auto;
			gap: 1.1rem;
		}

		.nav-idx {
			display: none;
		}

		.side-foot {
			flex-direction: row;
		}

		.theme-toggle {
			padding: 0.4rem 0.7rem;
		}

		.theme-name {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.side-nav {
			display: none;
		}

		.side-presence {
			display: none;
		}
	}
</style>