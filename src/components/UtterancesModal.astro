---
const REPO = 'huntedraven7/huntedraven7.github.io'
---

<div id="utterances-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
	<div class="relative w-full max-w-3xl mx-4 max-h-[80vh] flex flex-col">
		<button id="utterances-close" class="absolute -top-10 right-0 text-white/60 hover:text-white text-sm uppercase tracking-wider">Close</button>
		<div class="utterances-iframe-container border border-white/10 bg-white/[0.03] rounded-sm p-4 overflow-y-auto flex-1 min-h-[400px]"></div>
	</div>
</div>

<script>
	const modal = document.getElementById('utterances-modal')
	const btn = document.getElementById('utterances-btn')
	const close = document.getElementById('utterances-close')

	if (btn && modal && close) {
		btn.addEventListener('click', () => {
			modal.classList.remove('hidden')
			document.body.style.overflow = 'hidden'
			if (!document.getElementById('utterances-script')) {
				const s = document.createElement('script')
				s.src = 'https://utteranc.es/client.js'
				s.id = 'utterances-script'
				s.setAttribute('data-repo', REPO)
				s.setAttribute('data-issue-term', 'title')
				s.setAttribute('data-theme', 'dark')
				s.setAttribute('crossorigin', 'anonymous')
				s.async = true
				modal.querySelector('.utterances-iframe-container')?.appendChild(s)
			}
		})
		close.addEventListener('click', () => {
			modal.classList.add('hidden')
			document.body.style.overflow = ''
		})
		modal.addEventListener('click', (e) => {
			if (e.target === modal) {
				modal.classList.add('hidden')
				document.body.style.overflow = ''
			}
		})
	}
</script>
